import "../auth/models/user"
import "../todo/list"
import "../todo/todo"
import "../todo/comment"

datasource db {
    provider = "postgresql"
    url = env("POSTGRES_URL_NON_POOLING")
}

plugin policy {
    provider = '@zenstackhq/plugin-policy'
}

mutation procedure signUp(email: String, password: String, name: String?): User
